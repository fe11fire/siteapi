{
    "name": "fellfire/siteapi",
    "type": "library",
    "config": {
        "preferred-install": "dist",
        "disable-tls": false,
        "secure-http": true,
        "platform-check": true
    },
    "authors": [
        {
            "name": "fellfire none",
            "email": "r1der88@mail.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "SiteApi\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "monolog/monolog": "^3.8",
        "nesbot/carbon": "^2.73",
        "phpmailer/phpmailer": "^6.9",
        "predis/predis": "^2.3",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-memcached": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-session": "*"
    }
}
